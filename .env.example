# ==========================================================
# JANSETU AI — Environment Configuration (Hackathon Prototype)
# ==========================================================
# IMPORTANT:
# - JANSETU operates in 100% offline DEMO MODE by default (Zero billing / Zero external dependency).
# - Supplying a Gemini API key activates Real AI Multilingual Intelligence (Kannada/English).
# - Never commit your live production API keys to source control.
# ==========================================================

# Optional: Google Gemini API Key (Gemini 1.5 Flash / Gemini 2.0 Flash)
# Get a key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# AI Provider Selection: 'auto' | 'gemini' | 'demo'
# - auto: Uses Gemini if VITE_GEMINI_API_KEY is present, otherwise falls back to DemoProvider.
# - demo: Forces deterministic offline intelligence (recommended for repeatable judging).
# - gemini: Direct Gemini invocation.
VITE_AI_PROVIDER=auto

# Optional: Preferred Gemini Model
VITE_GEMINI_MODEL=gemini-1.5-flash
