# ==========================================================
# JANSETU AI — Frontend Environment Configuration
# ==========================================================
# The frontend connects strictly to the secure JANSETU backend.
# The Gemini API key is stored ONLY on the backend in server/.env.
# ==========================================================

# Backend API Gateway URL (Defaults to http://localhost:8787)
VITE_API_BASE_URL=http://localhost:8787

# Optional: Force Demo mode for offline presentations ('auto' | 'demo')
VITE_AI_PROVIDER=auto
